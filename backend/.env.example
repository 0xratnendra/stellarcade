# General
PORT=3000
NODE_ENV=development
# Max request body size accepted by Express (default: 100kb)
BODY_SIZE_LIMIT=100kb
# Deployment-map profile served by the contract registry endpoints (default: Dev)
NETWORK_PROFILE=Dev

# CORS
# Comma-separated list of allowed origins (web frontends).
# Requests with no Origin header (server-to-server, health checks) are always allowed.
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stellarcade
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stellarcade

# Redis
REDIS_URL=redis://localhost:6379

# Stellar Network
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_REQUEST_TIMEOUT=30000
STELLAR_MAX_RETRIES=3
STELLAR_RETRY_INTERVAL=1000

# Contract IDs
PRIZE_POOL_CONTRACT_ID=C...
RNG_CONTRACT_ID=C...
COIN_FLIP_CONTRACT_ID=CD2JPFUCKNDMA3OVYVQOAELTMR5VQPMAA6J6GJYQE2SQFNGKCBSSOKG5
# Optional until the dice-roll contract is deployed.
DICE_ROLL_CONTRACT_ID=
RANDOM_GENERATOR_CONTRACT_ID=CD3VAX3DZEGWEMMPK35MYPS43HMFTNHZK5SY22JLEHHENXJATWP4HJY5

# RNG oracle worker (fulfils random-generator requests, resolves registered games)
# ORACLE_SECRET_KEY must be the `oracle` address passed to random-generator init.
# Never commit a real secret key.
ORACLE_ENABLED=false
ORACLE_SECRET_KEY=
ORACLE_MIN_QUEUE=20
ORACLE_POLL_INTERVAL_MS=5000
# Ledger to start polling from on first run (defaults to the latest ledger)
ORACLE_START_LEDGER=

# Coin-flip event indexer worker (mirrors on-chain bets into the games table)
INDEXER_ENABLED=false
INDEXER_POLL_INTERVAL_MS=5000
# Ledger to start indexing from on first run (defaults to the latest ledger)
INDEXER_START_LEDGER=

# Auth
JWT_SECRET=your_super_secret_jwt_key_change_me

# Rate limiting (per IP; values below are the code defaults)
RATE_LIMIT_WALLET_MAX=10
RATE_LIMIT_WALLET_WINDOW=60
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_GAMES_MAX=60
RATE_LIMIT_GAMES_WINDOW=60

# Wallet deposits (optional; deposits return 503 VAULT_NOT_CONFIGURED when unset)
VAULT_ADDRESS=

# Webhook signature verification (required only for /api/webhook routes;
# without it those routes return 500 WEBHOOK secret missing)
WEBHOOK_SIGNING_SECRET=
# Allowed clock skew in seconds between the signed timestamp and now (default: 300)
WEBHOOK_SIGNATURE_TOLERANCE_SEC=300

# Startup validation notes:
# - `JWT_SECRET` is always required.
# - Use either `DATABASE_URL` OR all of DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# - `PORT` and `DB_PORT` must be positive integers when provided.
# - `STELLAR_NETWORK` must be one of: test, testnet, public, mainnet, futurenet, sandbox, standalone.
# - `HORIZON_URL` must start with http:// or https://.

# Logging
LOG_LEVEL=info
