{
  "name": "@stellarcade/contract-mock-generator",
  "version": "0.0.1",
  "description": "Generates mock TypeScript Soroban contract clients (vi.fn()-based) from Rust contract source, for frontend unit tests",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "contract-mock-generator": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run"
  },
  "keywords": ["soroban", "stellar", "mock", "codegen", "typescript", "testing", "cli"],
  "author": "StellarCade",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  }
}
